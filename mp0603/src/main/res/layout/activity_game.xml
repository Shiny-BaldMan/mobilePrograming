<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#FFF7FB">
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:text="@string/title" android:textSize="25sp" android:textColor="#8BC34A" android:textStyle="bold|italic" />
            <ImageView android:id="@+id/targetShape" android:layout_width="match_parent" android:layout_height="140dp" android:src="@drawable/circle" android:contentDescription="@string/circle" />
            <TextView android:id="@+id/instruction" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:text="@string/help" android:textSize="16sp" android:textColor="#192C48" />
            <TextView android:id="@+id/count" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:text="@string/help" android:textSize="20sp" android:textColor="#192C48" />
            <GridLayout android:id="@+id/pictureGrid" android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="3" />
            <Button android:id="@+id/resultButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:minHeight="52dp" android:text="@string/result" android:textAllCaps="false" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>