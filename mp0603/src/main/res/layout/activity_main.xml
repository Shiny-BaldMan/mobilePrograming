<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#FFF7FB">
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:text="@string/title" android:textSize="25sp" android:textColor="#8BC34A" android:textStyle="bold|italic" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:text="@string/help" android:textSize="16sp" android:textColor="#192C48" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="160dp" android:orientation="horizontal">
                <ImageView android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:src="@drawable/circle" android:contentDescription="@string/circle" />
                <ImageView android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:src="@drawable/square" android:contentDescription="@string/square" />
            </LinearLayout>
            <RadioGroup android:id="@+id/shapeChoice" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:checkedButton="@id/circleChoice">
                <RadioButton android:id="@+id/circleChoice" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="56dp" android:text="@string/circle" />
                <RadioButton android:id="@+id/squareChoice" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="56dp" android:text="@string/square" />
            </RadioGroup>
            <Button android:id="@+id/startButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:minHeight="52dp" android:text="@string/start" android:textAllCaps="false" />
            <TextView android:id="@+id/resultMessage" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:text="@string/result_help" android:textSize="20sp" android:textColor="#192C48" />
            <LinearLayout android:id="@+id/results" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>