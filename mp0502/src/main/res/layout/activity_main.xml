<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF5F8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CheckBox 실습"
            android:textColor="#558B2F"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="소방관에게 필요한 물건을 모두 골라 주세요."
            android:textColor="#222222"
            android:textSize="17sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:contentDescription="소방차"
                    android:scaleType="fitCenter"
                    android:src="@drawable/img1" />

                <CheckBox
                    android:id="@+id/checkFireTruck"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="소방차"
                    android:textColor="#222222"
                    android:textSize="14sp" />

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:layout_marginTop="16dp"
                    android:contentDescription="거품기"
                    android:scaleType="fitCenter"
                    android:src="@drawable/img2" />

                <CheckBox
                    android:id="@+id/checkMixer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="거품기"
                    android:textColor="#222222"
                    android:textSize="14sp" />

            </LinearLayout>

            <ImageView
                android:layout_width="0dp"
                android:layout_height="240dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="8dp"
                android:contentDescription="소방관"
                android:scaleType="fitCenter"
                android:src="@drawable/firefighter" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:contentDescription="청진기"
                    android:scaleType="fitCenter"
                    android:src="@drawable/img3" />

                <CheckBox
                    android:id="@+id/checkStethoscope"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="청진기"
                    android:textColor="#222222"
                    android:textSize="14sp" />

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:layout_marginTop="16dp"
                    android:contentDescription="장갑"
                    android:scaleType="fitCenter"
                    android:src="@drawable/img4" />

                <CheckBox
                    android:id="@+id/checkGloves"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="장갑"
                    android:textColor="#222222"
                    android:textSize="14sp" />

            </LinearLayout>

        </LinearLayout>

        <Button
            android:id="@+id/btnResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:backgroundTint="#00ACC1"
            android:text="결과보기"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/txtResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="소방관의 물품을 선택해주세요."
            android:textColor="#D84343"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>