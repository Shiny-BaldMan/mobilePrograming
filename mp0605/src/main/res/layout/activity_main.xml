<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#FFF7FB">
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:text="@string/title" android:textSize="25sp" android:textColor="#8BC34A" android:textStyle="bold|italic" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:text="@string/help" android:textSize="16sp" android:textColor="#192C48" />
            <EditText android:id="@+id/recipientInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginBottom="16dp" android:hint="@string/recipient_hint" android:inputType="textEmailAddress" android:singleLine="true" />
            <EditText android:id="@+id/subjectInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginBottom="16dp" android:hint="@string/subject_hint" android:inputType="textCapSentences" android:singleLine="true" />
            <EditText android:id="@+id/bodyInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginBottom="16dp" android:hint="@string/body_hint" android:inputType="textMultiLine" android:minLines="5" android:gravity="top|start" />
            <Button android:id="@+id/sendButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:minHeight="52dp" android:text="@string/send" android:textAllCaps="false" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:text="@string/tip" android:textSize="14sp" android:textColor="#192C48" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>