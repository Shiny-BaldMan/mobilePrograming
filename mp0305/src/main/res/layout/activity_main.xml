<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 창문 배경 이미지 (선택 사항) -->
    <ImageView
        android:id="@+id/windowView"
        android:layout_width="300dp"
        android:layout_height="300dp"
        app:srcCompat="@drawable/window"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/button_id"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 고양이 사진 출력 이미지 뷰 -->
    <ImageView
        android:id="@+id/imageView_id"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:scaleType="fitCenter"
        app:srcCompat="@drawable/cat1"
        app:layout_constraintTop_toTopOf="@id/windowView"
        app:layout_constraintBottom_toBottomOf="@id/windowView"
        app:layout_constraintStart_toStartOf="@id/windowView"
        app:layout_constraintEnd_toEndOf="@id/windowView" />

    <!-- 다음 보기 버튼 -->
    <Button
        android:id="@+id/button_id"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="다음보기"
        android:onClick="onButtonClick"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="50dp" />

</androidx.constraintlayout.widget.ConstraintLayout>