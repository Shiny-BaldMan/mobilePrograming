<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#FFF7FB">
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
            <TextView android:id="@+id/sceneTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:text="@string/park" android:textSize="25sp" android:textColor="#8BC34A" android:textStyle="bold|italic" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:text="@string/game_help" android:textSize="16sp" android:textColor="#192C48" />
            <TextView android:id="@+id/progress" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:text="@string/help" android:textSize="20sp" android:textColor="#192C48" />
            <com.example.mp0602.DifferenceBoard android:id="@+id/board" android:layout_width="match_parent" android:layout_height="wrap_content" android:contentDescription="@string/board_desc" />
            <Button android:id="@+id/backButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:minHeight="52dp" android:text="@string/back" android:textAllCaps="false" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>