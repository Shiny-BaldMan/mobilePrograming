<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:fitsSystemWindows="true" android:background="#F6F7F2">
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="빈칸에 들어갈 숫자는?" android:textSize="26sp" android:textColor="#233B42" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="오른쪽 위 메뉴에서 연산을 골라 보세요." android:textSize="16sp" android:textColor="#233B42" />
            <TextView android:id="@+id/operationLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="덧셈" android:textSize="18sp" android:textColor="#233B42" />
            <TextView android:id="@+id/feedback" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="아래 숫자 중 하나를 선택하세요." android:textSize="16sp" android:textColor="#233B42" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="96dp" android:orientation="horizontal">
                <ImageButton android:id="@+id/choice0" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_margin="6dp" android:padding="8dp" android:scaleType="fitCenter" android:backgroundTint="#E6EEE5" android:contentDescription="숫자 선택 1" />
                <ImageButton android:id="@+id/choice1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_margin="6dp" android:padding="8dp" android:scaleType="fitCenter" android:backgroundTint="#E6EEE5" android:contentDescription="숫자 선택 2" />
                <ImageButton android:id="@+id/choice2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_margin="6dp" android:padding="8dp" android:scaleType="fitCenter" android:backgroundTint="#E6EEE5" android:contentDescription="숫자 선택 3" />
            </LinearLayout>
            <FrameLayout android:id="@+id/chalkboard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
                <ImageView android:layout_width="match_parent" android:layout_height="wrap_content" android:src="@drawable/bg" android:adjustViewBounds="true" android:scaleType="fitCenter" android:contentDescription="고양이 칠판" />
                <LinearLayout android:id="@+id/equation" android:layout_width="match_parent" android:layout_height="64dp" android:gravity="center" android:orientation="horizontal" />
            </FrameLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>